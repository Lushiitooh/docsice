rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPER: cuenta administradora ─────────────────────────────────────────
    // El admin puede leer y modificar contratos de CUALQUIER prevencionista.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'lasepulveda@sice.com';
    }

    // ── HELPER: dueño del documento ───────────────────────────────────────────
    // El uid del documento debe coincidir con el uid del usuario autenticado.
    function isOwner() {
      return request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // ── REGLA GENERAL: autenticados pueden leer y escribir lo suyo ───────────
    // (fallback para colecciones no listadas abajo)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // ── CONTRATOS ─────────────────────────────────────────────────────────────
    match /contratos/{id} {
      allow read: if true;                                       // vista pública
      allow create: if request.auth != null;                     // cualquier prevencionista puede crear
      allow update, delete: if isAdmin() || isOwner();           // solo el dueño o admin puede modificar
    }

    // ── TRABAJADORES ──────────────────────────────────────────────────────────
    match /trabajadores/{id} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin() || isOwner();
    }

    // ── TIPOS DE DOCUMENTOS POR CONTRATO ─────────────────────────────────────
    match /doc_tipos/{id} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin() || isOwner();
    }

    // ── TIPOS DE DOCUMENTOS INDIVIDUALES POR TRABAJADOR ──────────────────────
    match /doc_tipos_worker/{id} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin() || isOwner();
    }

    // ── DOCUMENTOS CARGADOS ───────────────────────────────────────────────────
    match /docs_cargados/{id} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin() || isOwner();
    }
  }
}
